{
  "name": "@boozebunk/trpc",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/main.ts",
    "build": "bun build --entrypoints src/main.ts --outdir dist --target bun --minify",
    "start": "bun run dist/main.js",
    "client": "bun run src/client",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pre-commit": "lint-staged",
    "migration:generate": "bun --bun run drizzle-kit generate",
    "migration:custom": "bun --bun run drizzle-kit generate --custom --name",
    "migration:run": "bun --bun run src/db/migrate.ts",
    "migration:push": "drizzle-kit push",
    "db:seed": "bun --bun run src/db/seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/bun": "latest",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.31.1"
  },
  "peerDependencies": {
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/jwt": "^9.1.0",
    "@trpc/client": "^11.4.3",
    "@trpc/server": "^11.4.3",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.4.0",
    "postgres": "^3.4.7",
    "superjson": "^2.2.2",
    "uuid": "^11.1.0",
    "zod": "^4.0.17"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint . --fix"
    ]
  }
}
