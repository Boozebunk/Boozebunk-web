<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Welcome To Boozebunk</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Arial, sans-serif; color: #333; background-color: #f5f5f5;">
  <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; margin: 0 auto; background-color: #ffffff; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); margin-top: 20px; margin-bottom: 20px;">
    <tr>
      <td style="padding: 30px 30px 20px 30px; text-align: center; background-color: #4a6cf7; border-top-left-radius: 8px; border-top-right-radius: 8px;">
        <h1 style="color: #ffffff; margin: 0; font-size: 24px;">Welcome {{vendorName}}</h1>
      </td>
    </tr>
    <tr>
      <td style="padding: 30px;">
        <p style="margin-bottom: 25px; line-height: 1.5; font-size: 16px;">The Below is you Id and Password</p>
        
        <p style="margin-bottom: 5px; line-height: 1.5; font-size: 14px; background-color: #f8f9fa; padding: 15px; border-radius: 6px; word-break: break-all; border: 1px solid #e9ecef;">{{email}}</p>
        <p style="margin-bottom: 25px; line-height: 1.5; font-size: 14px; background-color: #f8f9fa; padding: 15px; border-radius: 6px; word-break: break-all; border: 1px solid #e9ecef;">{{password}}</p>
      </td>
    </tr>
    <tr>
      <td style="padding: 20px; text-align: center; background-color: #f8f9fa; border-bottom-left-radius: 8px; border-bottom-right-radius: 8px; border-top: 1px solid #e9ecef;">
        <p style="margin: 0; color: #666; font-size: 14px;">Thank you,</p>
        <p style="margin: 5px 0 0 0; font-weight: bold; color: #444; font-size: 16px;">The Boozebunk Team</p>
      </td>
    </tr>
  </table>
</body>
</html> 